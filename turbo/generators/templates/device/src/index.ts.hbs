import { Class } from '@zenfs/linux'
import type { KernelCharDevice, KernelContext, KernelDeviceCLIOptions } from '@ecmaos/types'

export const pkg = {
  name: '{{ name }}',
  version: '0.1.0',
  description: '{{ description }}'
}

export async function cli(options: KernelDeviceCLIOptions) {
  options.kernel.log.debug(`${pkg.name} CLI`, options.args)
  return 0
}

/** `/sys/class/{{ name }}` */
const {{ name }}_class = new Class('{{ name }}')

export async function getDrivers(ctx: KernelContext): Promise<KernelCharDevice[]> {
  return [{
    name: '{{ name }}',
    // Pick a real Linux major number for the device class this driver resembles (misc/10 is a safe
    // default for a one-off device with no closer analog) -- see the other devices/*/src/index.ts
    // drivers and https://www.kernel.org/doc/html/latest/admin-guide/devices.html for reference.
    major: 10,
    minor: 1,
    class: {{ name }}_class,
    ops: {
      read: () => 0,
      write: (file, buffer, offset) => {
        const text = new TextDecoder().decode(buffer.subarray(offset))
        ctx.log.debug(`[{{ name }}:${ctx.id}] ${text}`)
      }
    }
  }]
}
