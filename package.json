{
  "name": "ecmaos",
  "version": "0.11.0",
  "description": "ecmaOS: Micro-kernel and framework for web technologies",
  "homepage": "https://github.com/ecmaos/ecmaos#readme",
  "license": "MIT OR Apache-2.0",
  "author": {
    "name": "Jay Mathis",
    "email": "code@mathis.network",
    "url": "https://github.com/mathiscode"
  },
  "contributors": [
    {
      "name": "James Prevett",
      "email": "jp@jamespre.dev",
      "url": "https://github.com/james-pre"
    }
  ],
  "repository": "https://github.com/ecmaos/ecmaos",
  "bugs": "https://github.com/ecmaos/ecmaos/issues",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "build:docs": "typedoc && echo docs.ecmaos.sh > docs/CNAME",
    "check:initfs": "node utils/initfs.mjs check",
    "check:license-boundary": "node scripts/check-license-boundary.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:reuse": "node scripts/reuse-toml.mjs --check && reuse lint",
    "build:kernel": "turbo run build --filter=@ecmaos/* --filter=@ecmaos-devices/*",
    "dev": "turbo run dev --filter=@ecmaos/* --filter=@ecmaos-apps/desktop --concurrency=20",
    "dev:kernel": "turbo run dev --filter=@ecmaos/kernel",
    "dev:docs": "pnpm sync:readme && concurrently nodemon \"pnpx serve --cors -l 30444 ./docs\"",
    "fix": "prettier --write \"**/*.{ts,tsx,md}\"",
    "fix:repo": "sherif --fix",
    "lint": "turbo run lint",
    "lint:repo": "sherif",
    "preinstall": "npx only-allow pnpm",
    "publish-packages": "turbo run build lint test && pnpm sync && git commit -am \"chore: sync version and docs\" && changeset version && changeset publish",
    "start": "turbo run dev --filter=@ecmaos/kernel",
    "sync": "pnpm sync:readme && pnpm sync:index && pnpm sync:version && pnpm sync:version:html && pnpm build:docs && pnpm sync:tutorials && pnpm sync:docs && pnpm sync:licenses && pnpm sync:reuse && pnpm sync:zenfs && pnpm sync:initfs",
    "sync:docs": "rm -rf core/kernel/public/initfs/usr/share/docs/@ecmaos/kernel/docs && cp -r docs core/kernel/public/initfs/usr/share/docs/@ecmaos/kernel",
    "sync:initfs": "node utils/initfs.mjs build",
    "sync:licenses": "cp LICENSE LICENSE-APACHE LICENSE-MIT core/kernel/public/initfs/usr/share/licenses/@ecmaos/kernel/ && for p in utils utils-copyleft; do rm -rf core/kernel/public/initfs/usr/share/licenses/@ecmaos/core$p && mkdir -p core/kernel/public/initfs/usr/share/licenses/@ecmaos && cp -r core/$p/licenses core/kernel/public/initfs/usr/share/licenses/@ecmaos/core$p; done && node utils/sync-zenfs-licenses.mjs",
    "sync:index": "mkdir -p core/kernel/public/initfs/usr/share/ecmaos/package-index && cp utils/package-index/index.json core/kernel/public/initfs/usr/share/ecmaos/package-index/index.json",
    "sync:readme": "cp README.md core/kernel/README.md && cp README.md core/kernel/public/initfs/usr/share/docs/@ecmaos/kernel/index.md",
    "sync:tutorials": "./utils/sync-tutorials.sh",
    "sync:version": "pnpm version $(node -e \"console.log(require('./core/kernel/package.json').version)\") --no-git-tag-version || true",
    "sync:version:html": "./utils/sync-html-version.js",
    "sync:version:tag": "pnpm version $(node -e \"console.log(require('./core/kernel/package.json').version)\")",
    "sync:reuse": "node scripts/reuse-toml.mjs",
    "sync:zenfs": "./utils/sync-zenfs.sh",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:bench": "turbo run test:bench",
    "test:ui": "turbo run test:ui",
    "test:watch": "turbo run test:watch"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@ecmaos/config-typescript": "workspace:^",
    "@turbo/gen": "^2.11.10",
    "@typhonjs-typedoc/ts-lib-docs": "^2024.12.25",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "sherif": "^1.13.0",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "canvas": "Automattic/node-canvas#master"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "22.20.2",
      "memium": "^1.0.4",
      "@zenfs/core": "^2.7.7"
    }
  }
}
