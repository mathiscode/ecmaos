{
  "extends": "@ecmaos/config-typescript/tsconfig.base.json",
  "include": ["core/**/*.ts"],
  "exclude": [
    "**/node_modules/**/*",
    "**/dist/**/*",
    "**/tests/**/*",
    "core/metal",
    "core/swapi",
    "core/bios",
    "core/jaffa",
    "core/kernel/src/ui.ts",
    "**/vite.config.ts",
    "**/vite-plugin-*.ts"
  ],
  "compilerOptions": {
    "rootDir": "./core",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "ES2022",
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "vim-wasm/vimwasm.js": ["./core/utils/src/types/vim-wasm.d.ts"]
    }
  }
}