{
  "name": "@ecmaos/jaffa",
  "version": "0.2.27",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "description": "ecmaOS as a Tauri desktop application",
  "comment:files": "A Tauri app ships as a platform bundle, not a JS entry point, so this package publishes the buildable source (`pnpm buildx && pnpm build:tauri`) rather than a dist/ nobody can import.",
  "files": [
    "index.html",
    "src",
    "src-tauri",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "scripts": {
    "buildx": "tsc && vite build",
    "build:tauri": "tauri build",
    "bundle": "pnpm build:tauri && pnpm bundle",
    "devx": "vite",
    "dev:tauri": "tauri dev",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ecmaos/kernel": "workspace:^",
    "@ecmaos/types": "workspace:^",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-shell": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "sass-embedded": "^1.79.4",
    "typescript": "^7.0.2",
    "user-agent-data-types": "^0.4.2",
    "vite": "^8.3.1",
    "vite-plugin-i18next-loader": "^2.0.13",
    "vite-plugin-node-polyfills": "^0.28.0"
  }
}
