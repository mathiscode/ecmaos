    {
      "name": "James Prevett",
      "email": "jp@jamespre.dev",
      "url": "https://github.com/james-pre"
    }
  ],
  "bugs": {
    "url": "https://github.com/ecmaos/ecmaos/issues",
    "email": "code@mathis.network"
  },
  "knownIssues": [
    "To disable known issues, type `touch /etc/noissues`",
    "It's best to stick to Chromium-based browsers for the most features",
    "Keyboard is broken on mobile; ecmaOS is not mobile-friendly at this time",
    "Don't expect any sort of POSIX compliance at this stage",
    "Most commands/devices are very basic implementations, not complete reproductions",
    "Lots of unfinished work; watch your step"
  ],
  "tips": [
    "To disable tips, type `touch /etc/notips`",
    "ecmaos.sh has no backend server; all data is stored and processed entirely in your browser",
    "If it ever fails to boot, check your logs, try clearing all data, try incognito mode, or try another browser",
    "You can switch between TTYs using CTRL+SHIFT+<0-9>",
    "You can change the terminal theme with the `theme` command",
    "You can run some devices that offer a CLI - e.g. '/dev/battery --help'",
    "Use the 'install' command to install packages - e.g. 'install @ecmaos-apps/news'",
    "You can install any NPM package - e.g. 'install jquery'",
    "You can use the 'mount' command to view and mount filesystems (/etc/fstab supported)",
    "Use the 'news' command to see the latest news about ecmaOS",
    "Type 'ls /bin' to see all built-in commands",
    "Type 'ls /usr/bin' to see all installed commands",
    "Type 'ls /dev' to see all available devices",
    "You can set your environment variables in ~/.env (try setting PROMPT to a PS1-like format)",
    "You can register and login with a passkey: 'passkey register' and 'passkey list'",
    "The 'man' command can be used to view the manual pages for packages: 'man @ecmaos/kernel'",
    "Try 'fetch /xkcd-os.sixel'"
  ],
  "type": "module",
  "files": [
    "dist",
    "!dist/programs",
    "!dist/sources",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kernel.js",
      "require": "./dist/kernel.umd.cjs"
    },
    "./auth": "./src/tree/auth.ts",
    "./components": "./src/tree/components.ts",
    "./device": "./src/tree/device.ts",
    "./dom": "./src/tree/dom.ts",
    "./events": "./src/tree/events.ts",
    "./filesystem": "./src/tree/filesystem.ts",
    "./fonts": "./dist/importable-fonts",
    "./i18n": "./src/tree/i18n.ts",
    "./intervals": "./src/tree/intervals.ts",
    "./kernel": "./src/tree/kernel.ts",
    "./lib/crontab": "./src/tree/lib/crontab.ts",
    "./lib/display-sandbox": "./src/tree/lib/display-sandbox.ts",
    "./lib/remote-fs": "./src/tree/lib/remote-fs.ts",
    "./lib/remote-mount": "./src/tree/lib/remote-mount.ts",
    "./lib/remote-device": "./src/tree/lib/remote-device.ts",
    "./log": "./src/tree/log.ts",
    "./memory": "./src/tree/memory.ts",
    "./processes": "./src/tree/processes.ts",
    "./protocol": "./src/tree/protocol.ts",
    "./service": "./src/tree/service.ts",
    "./shell": "./src/tree/shell.ts",
    "./windowserver": "./src/tree/windowserver.ts",
    "./storage": "./src/tree/storage.ts",
    "./telemetry": "./src/tree/telemetry.ts",
    "./terminal": "./src/tree/terminal.ts",
    "./ui": "./dist/ui.js",
    "./ui.css": "./dist/kernel.css",
    "./users": "./src/tree/users.ts",
    "./wasm": "./src/tree/wasm.ts",
    "./windows": "./src/tree/windows.ts",
    "./workers": "./src/tree/workers.ts"
  },
  "imports": {
    "#*": "./src/tree/*"
  },
  "scripts": {
    "build": "node scripts/splash.mjs && node ../../utils/initfs.mjs build --if-possible && node scripts/build-modules.mjs && vite build && cp index-dist.html dist/index.html",
    "dev": "node scripts/splash.mjs && node ../../utils/initfs.mjs build --if-possible && node scripts/build-modules.mjs && vite",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:full": "CORPUS=1 vitest run",
    "test:corpus": "CORPUS=1 vitest run corpus",
    "test:group": "node scripts/test-group.mjs",
    "test:changed": "node scripts/test-changed.mjs",
    "test:slow": "SLOW=1 vitest run slow",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --coverage --ui",
    "test:bench": "vitest bench"
  },
  "publishConfig": {
    "access": "public"
  },
