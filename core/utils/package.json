{
  "name": "@ecmaos/coreutils",
  "description": "ecmaOS: Core utilities for the ecmaOS framework",
  "version": "0.6.5",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://ecmaos.sh",
  "repository": "https://github.com/ecmaos/ecmaos",
  "author": {
    "name": "Jay Mathis",
    "email": "code@mathis.network",
    "url": "https://github.com/mathiscode"
  },
  "bugs": {
    "url": "https://github.com/ecmaos/ecmaos/issues",
    "email": "code@mathis.network"
  },
  "type": "module",
  "files": [
    "dist",
    "programs",
    "licenses",
    "src/commands-execve",
    "src/lib",
    "wasm"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./programs/*": "./programs/*"
  },
  "scripts": {
    "build": "tsc && node ../../utils/programs-manifest.mjs --check",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@ecmaos/types": "workspace:^",
    "@zenfs/core": "^2.7.7",
    "@zenfs/linux": "0.6.1",
    "@zip.js/zip.js": "^2.24.0",
    "ansi-escape-sequences": "^6.2.4",
    "buffer": "6.0.3",
    "chalk": "^6.0.1",
    "columnify": "^1.6.0",
    "command-line-args": "^6.0.2",
    "command-line-usage": "^7.0.4",
    "cron-schedule": "^6.0.0",
    "cronstrue": "^3.38.0",
    "human-format": "^1.4.0",
    "isomorphic-git": "^1.44.4",
    "modern-tar": "^0.8.6",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/ansi-escape-sequences": "^4.0.4",
    "@types/columnify": "^1.5.4",
    "@types/command-line-args": "^5.2.3",
    "@types/command-line-usage": "^5.0.4",
    "@types/node": "22.20.2",
    "user-agent-data-types": "^0.4.3",
    "vitest": "^5.0.5"
  }
}
