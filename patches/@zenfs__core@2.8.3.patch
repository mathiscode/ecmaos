+/**
+ * POSIX ACLs as Linux keeps them: the `system.posix_acl_access` and `system.posix_acl_default` extended attributes, a 4-byte
+ * little-endian version (2) and 8-byte entries of tag, permissions and id. The permission check (`aclAllows`) and the rule for
+ * the ACL a new file or directory starts with (`creationAcl`) live here. Added to @zenfs/core for ecmaOS.
+ * @internal
+ */
+export const ACL_ACCESS = 'system.posix_acl_access';
+export const ACL_DEFAULT = 'system.posix_acl_default';
+const USER_OBJ = 0x01;
+const USER = 0x02;
+const GROUP_OBJ = 0x04;
+const GROUP = 0x08;
+const MASK = 0x10;
+const OTHER = 0x20;
+const NO_ID = 0xffffffff;
+export function decodeAcl(bytes) {
+    const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+    if (bytes.length < 4 || view.getUint32(0, true) !== 2)
+        return;
+    const entries = [];
+    for (let at = 4; at + 8 <= bytes.length; at += 8) {
+        entries.push({ tag: view.getUint16(at, true), perm: view.getUint16(at + 2, true), id: view.getUint32(at + 4, true) });
+    }
+    return entries;
+}
+export function encodeAcl(entries) {
+    const bytes = new Uint8Array(4 + entries.length * 8);
+    const view = new DataView(bytes.buffer);
+    view.setUint32(0, 2, true);
+    entries.forEach((entry, index) => {
+        const at = 4 + index * 8;
+        view.setUint16(at, entry.tag, true);
+        view.setUint16(at + 2, entry.perm, true);
+        view.setUint32(at + 4, entry.tag === USER || entry.tag === GROUP ? entry.id : NO_ID, true);
+    });
+    return bytes;
+}
+/** The entries of an inode's ACL (`system.posix_acl_access` unless `name` says otherwise), or undefined when it has none */
+export function aclOf(inode, name = ACL_ACCESS) {
+    const attributes = inode.attributes;
+    if (!attributes || !attributes.size)
+        return;
+    const raw = attributes.get(name);
+    return raw ? decodeAcl(raw) : undefined;
+}
+const isExtended = entries => entries.some(entry => entry.tag === USER || entry.tag === GROUP);
+/**
+ * Linux's rule for an inode with an ACL. The owner is judged by `user::` (the mode's owner bits); a named user by its entry and
+ * the mask; the group class (the owning group and the named groups) by whether any of the process's matching entries, limited by
+ * the mask, grants everything wanted, and a process in the class that none grants is refused; everyone else by `other::`.
+ * The mask is the mode's group bits, which is where `chmod` and `setfacl` keep it.
+ */
+export function aclAllows(credentials, inode, entries, access) {
+    const wanted = access & 7;
+    const mode = Number(inode.mode);
+    const { euid, egid, groups } = credentials;
+    if (euid === inode.uid)
+        return ((mode >> 6) & wanted) === wanted;
+    const mask = (mode >> 3) & 7;
+    const named = entries.find(entry => entry.tag === USER && entry.id === euid);
+    if (named)
+        return (named.perm & mask & wanted) === wanted;
+    const inGroup = id => egid === id || groups.includes(id);
+    let matched = false;
+    if (inGroup(Number(inode.gid))) {
+        matched = true;
+        const owner = entries.find(entry => entry.tag === GROUP_OBJ);
+        if (((owner ? owner.perm : mask) & mask & wanted) === wanted)
+            return true;
+    }
+    for (const entry of entries) {
+        if (entry.tag !== GROUP || !inGroup(entry.id))
+            continue;
+        matched = true;
+        if ((entry.perm & mask & wanted) === wanted)
+            return true;
+    }
+    if (matched)
+        return false;
+    return (mode & wanted) === wanted;
+}
+/**
+ * What a new entry in a directory starts with. Without a default ACL on the parent it is the requested mode less the umask. With
+ * one, the umask is not applied: the default entries become the new entry's ACL, limited by the requested mode, and a directory
+ * also keeps the default ACL itself. Returns the creation `mode`, and the `access` and `def` attribute values to put on the new
+ * inode when there are any.
+ */
+export function creationAcl(umask, requested, parent, isDirectory) {
+    const raw = parent.attributes && parent.attributes.size ? parent.attributes.get(ACL_DEFAULT) : undefined;
+    const defaults = raw ? decodeAcl(raw) : undefined;
+    if (!defaults)
+        return { mode: requested & ~(umask & 0o777) };
+    const entries = defaults.map(entry => ({ ...entry }));
+    const find = tag => entries.find(entry => entry.tag === tag);
+    const user = find(USER_OBJ);
+    const group = find(GROUP_OBJ);
+    const mask = find(MASK);
+    const other = find(OTHER);
+    if (user)
+        user.perm &= (requested >> 6) & 7;
+    if (other)
+        other.perm &= requested & 7;
+    if (mask)
+        mask.perm &= (requested >> 3) & 7;
+    else if (group)
+        group.perm &= (requested >> 3) & 7;
+    const perm = ((user?.perm ?? (requested >> 6) & 7) << 6) | (((mask ?? group)?.perm ?? (requested >> 3) & 7) << 3) | (other?.perm ?? requested & 7);
+    return {
+        mode: (requested & ~0o777) | perm,
+        access: isExtended(entries) ? encodeAcl(entries) : undefined,
+        def: isDirectory ? raw : undefined,
+    };
+}
+/** Puts the attributes `creationAcl` returned on a new inode; true when there were any to put */
+export function applyCreationAcl(inode, created, Attributes) {
+    if (!created.access && !created.def)
+        return false;
+    inode.attributes ??= new Attributes();
+    if (created.access)
+        inode.attributes.set(ACL_ACCESS, created.access);
+    if (created.def)
+        inode.attributes.set(ACL_DEFAULT, created.def);
+    return true;
+}
