 #undef __setjmp_attr
diff --git c/src/setjmp/wasm32/rt.c i/src/setjmp/wasm32/rt.c
new file mode 100644
index 0000000..eccaa6b
--- /dev/null
+++ i/src/setjmp/wasm32/rt.c
@@ -0,0 +1,37 @@
+/* ecmaOS: the runtime half of WebAssembly setjmp/longjmp. With -fwasm-exceptions and -mllvm -wasm-enable-sjlj the
+ * compiler turns each setjmp() into __wasm_setjmp(), each place a longjmp() may land into __wasm_setjmp_test(), and
+ * longjmp() into __wasm_longjmp(), which throws the __c_longjmp exception the function that called setjmp catches.
+ * The jmp_buf holds which call of which function set it (so a stale buffer is not taken for a live one) and the
+ * value to return. */
+#include <setjmp.h>
+#include <stdint.h>
+
+struct wasm_jmp {
+	void *invocation;
+	uint32_t label;
+	struct { void *env; int val; } arg;
+};
+
+_Static_assert(sizeof(struct wasm_jmp) <= sizeof(__jmp_buf), "jmp_buf too small");
+
+void __wasm_setjmp(void *env, uint32_t label, void *invocation)
+{
+	struct wasm_jmp *jb = env;
+	if (!label || !invocation) __builtin_trap();
+	jb->invocation = invocation;
+	jb->label = label;
+}
+
+uint32_t __wasm_setjmp_test(void *env, void *invocation)
+{
+	struct wasm_jmp *jb = env;
+	return jb->invocation == invocation ? jb->label : 0;
+}
+
+_Noreturn void __wasm_longjmp(void *env, int val)
+{
+	struct wasm_jmp *jb = env;
+	jb->arg.env = env;
+	jb->arg.val = val ? val : 1;
+	__builtin_wasm_throw(1, &jb->arg);
+}
diff --git c/src/signal/wasm32/siglongjmp.c i/src/signal/wasm32/siglongjmp.c
new file mode 100644
index 0000000..f4abb56
--- /dev/null
+++ i/src/signal/wasm32/siglongjmp.c
@@ -0,0 +1,9 @@
+/* ecmaOS: puts back the mask sigsetjmp saved, then jumps. */
+#include <setjmp.h>
+#include <signal.h>
+
+_Noreturn void siglongjmp(sigjmp_buf buf, int ret)
+{
+	if (buf->__fl) pthread_sigmask(SIG_SETMASK, (sigset_t *)buf->__ss, 0);
+	longjmp(buf, ret);
+}
diff --git c/src/signal/wasm32/sigsetjmp.c i/src/signal/wasm32/sigsetjmp.c
new file mode 100644
index 0000000..c8184c4
--- /dev/null
+++ i/src/signal/wasm32/sigsetjmp.c
@@ -0,0 +1,10 @@
+/* ecmaOS: sigsetjmp is a macro (include/setjmp.h) that saves the mask here and then calls setjmp, since a function
+ * that returns twice cannot be wrapped. */
+#include <setjmp.h>
+#include <signal.h>
+
+void __sigsetjmp_save(sigjmp_buf buf, int save)
+{
+	buf->__fl = save;
+	if (save) pthread_sigmask(SIG_SETMASK, 0, (sigset_t *)buf->__ss);
+}
