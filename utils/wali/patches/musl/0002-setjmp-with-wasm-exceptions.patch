ecmaOS: setjmp and longjmp on WebAssembly exception handling. The compiler (-fwasm-exceptions -mllvm
-wasm-enable-sjlj) lowers them to __wasm_setjmp, __wasm_setjmp_test and __wasm_longjmp, which this adds; the
header stops declaring them as host imports. sigsetjmp saves the signal mask before calling setjmp and siglongjmp
restores it.

diff --git c/include/setjmp.h i/include/setjmp.h
index 48b37b8..da64760 100644
--- c/include/setjmp.h
+++ i/include/setjmp.h
@@ -21,39 +21,27 @@ typedef struct __jmp_buf_tag {
 #define __setjmp_attr
 #endif
 
+/* ecmaOS: setjmp and longjmp are lowered by the compiler (wasm exception handling, -mllvm -wasm-enable-sjlj) to
+ * calls into src/setjmp/wasm32/rt.c, so they are plain declarations here rather than host imports. The other names
+ * are the same jump: sigsetjmp saves the signal mask in the buffer first, and siglongjmp puts it back. */
+int setjmp (jmp_buf) __setjmp_attr;
+_Noreturn void longjmp (jmp_buf, int);
+
 #if defined(_POSIX_SOURCE) || defined(_POSIX_C_SOURCE) \
  || defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) \
  || defined(_BSD_SOURCE)
 typedef jmp_buf sigjmp_buf;
-int sigsetjmp (sigjmp_buf, int) __setjmp_attr __attribute((
-  __import_module__("wali"),
-  __import_name__("sigsetjmp")
-));
+void __sigsetjmp_save (sigjmp_buf, int);
+#define sigsetjmp(buf, save) (__sigsetjmp_save((buf), (save)), setjmp(buf))
 _Noreturn void siglongjmp (sigjmp_buf, int);
 #endif
 
 #if defined(_XOPEN_SOURCE) || defined(_GNU_SOURCE) \
  || defined(_BSD_SOURCE)
-int _setjmp (jmp_buf) __setjmp_attr __attribute((
-  __import_module__("wali"),
-  __import_name__("_setjmp")
-));
-_Noreturn void _longjmp (jmp_buf, int) __attribute((
-  __import_module__("wali"),
-  __import_name__("_longjmp")
-));
+#define _setjmp(buf) setjmp(buf)
+#define _longjmp(buf, val) longjmp((buf), (val))
 #endif
 
-int setjmp (jmp_buf) __setjmp_attr __attribute((
-  __import_module__("wali"),
-  __import_name__("setjmp")
-));
-
-_Noreturn void longjmp (jmp_buf, int) __attribute((
-  __import_module__("wali"),
