ecmaOS: <string.h> no longer declares basename() without a prototype for _GNU_SOURCE, as upstream musl 1.2.5 does
not. In C23 `char *basename();` takes no arguments, so it conflicts with <libgen.h>'s declaration in a program that
includes both (xz's file_io.c, built with -std=gnu23).

--- i/include/string.h
+++ w/include/string.h
@@ -95,8 +95,5 @@
 void *memmem(const void *, size_t, const void *, size_t);
 void *memrchr(const void *, int, size_t);
 void *mempcpy(void *, const void *, size_t);
-#ifndef __cplusplus
-char *basename();
-#endif
 #endif
 
