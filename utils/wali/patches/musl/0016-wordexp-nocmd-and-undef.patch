+static const char *nocmd_dquote(const char *s, int *err)
+{
+	for (s++; *s != '"'; ) switch (*s) {
+	case 0:
+		*err = WRDE_SYNTAX;
+		return 0;
+	case '\\':
+		if (!s[1]) return *err = WRDE_SYNTAX, (char *)0;
+		s += 2;
+		break;
+	case '`':
+		return *err = WRDE_CMDSUB, (char *)0;
+	case '$':
+		if (!(s = nocmd_dollar(s, DQ, err))) return 0;
+		break;
+	default:
+		s++;
+	}
+	return s+1;
+}
