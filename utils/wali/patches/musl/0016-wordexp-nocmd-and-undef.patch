+		return *err = WRDE_CMDSUB, (char *)0;
+	case '$':
+		if (!(s = nocmd_dollar(s, dq ? BRACE_DQ : BRACE, err))) return 0;
+		break;
+	default:
+		s++;
+	}
+	return s+1;
+}
+
+static const char *nocmd_arith(const char *s, int *err)
+{
+	size_t depth = 0;
+	for (;;) switch (*s) {
+	case 0:
+	case '#':
+	case '"':
+	case '\'':
+	case '\\':
+		return *err = WRDE_SYNTAX, (char *)0;
+	case '(':
+		depth++;
+		s++;
+		break;
+	case ')':
+		if (depth) { depth--; s++; break; }
+		if (s[1] == ')') return s+2;
+		/* $( (...) ...): a command substitution beginning with a subshell */
+		return *err = WRDE_CMDSUB, (char *)0;
+	case '`':
+		return *err = WRDE_CMDSUB, (char *)0;
+	case '{':
+	case '}':
+		return *err = WRDE_BADCHAR, (char *)0;
+	case '$':
+		if (!(s = nocmd_dollar(s, ARITH, err))) return 0;
+		break;
+	default:
+		s++;
+	}
+}
+
+static const char *nocmd_dollar(const char *s, int ctx, int *err)
+{
+	switch (s[1]) {
+	case '(':
+		if (s[2] == '(') return nocmd_arith(s+3, err);
+		return *err = WRDE_CMDSUB, (char *)0;
+	case '{':
+		return nocmd_brace(s+2, ctx == DQ || ctx == BRACE_DQ, err);
+	case '\'':
+		/* $'...' quotes at the top; in double quotes it is a dollar sign; in ${...} and $((...)) shells differ */
+		if (ctx == DQ) return s+1;
+		if (ctx != TOP) return *err = WRDE_SYNTAX, (char *)0;
+		for (s += 2; *s != '\''; s++) {
+			if (!*s || (*s == '\\' && !*++s)) return *err = WRDE_SYNTAX, (char *)0;
+		}
+		return s+1;
+	}
+	return s+1;
+}
+
+static int nocmd(const char *s)
+{
+	int err = 0, start = 1;
+	while (*s) {
+		if (*s == '\\' && s[1] == '\n') { s += 2; continue; }
+		if (*s == '#' && start) {
+			while (*s && *s != '\n') s++;
+			continue;
+		}
+		start = 0;
+		switch (*s) {
+		case ' ':
+		case '\t':
+			start = 1;
+			s++;
+			break;
+		case '\\':
+			s += 1 + !!s[1];
+			break;
+		case '\'':
+			if (!(s = nocmd_squote(s, &err))) return err;
+			break;
+		case '"':
+			if (!(s = nocmd_dquote(s, &err))) return err;
+			break;
+		case '$':
+			if (!(s = nocmd_dollar(s, TOP, &err))) return err;
+			break;
+		case '`':
+			return WRDE_CMDSUB;
+		case '\n':
+		case '|':
+		case '&':
+		case ';':
+		case '<':
+		case '>':
+		case '(':
+		case ')':
+		case '{':
+		case '}':
+			return WRDE_BADCHAR;
+		default:
+			s++;
+		}
+	}
+	return 0;
+}
