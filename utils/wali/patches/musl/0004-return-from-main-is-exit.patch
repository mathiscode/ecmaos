ecmaOS: returning from main is exit() with its value, as C requires: atexit handlers, static destructors and the
stdio flush run. WALI's _start called the host's __proc_exit directly, so output still in a buffer was lost.

diff --git i/crt/crt1-command.c w/crt/crt1-command.c
index 86ea440..0f1b9a8 100644
--- i/crt/crt1-command.c
+++ w/crt/crt1-command.c
@@ -1,3 +1,5 @@
+#include <stdlib.h>
+
 extern int __main_void(void);
 extern int __wali_startup(void);
 extern int __wali_cleanup(void);
@@ -7,26 +9,19 @@ void __wali_proc_exit(int) __attribute((
   __import_name__("__proc_exit")
 ));
 
+/* ecmaOS: returning from main is exit() with its value, so atexit handlers, destructors and the stdio flush run
+ * (WALI's _start called __proc_exit directly, and output still in a buffer was lost). The engine's cleanup runs as
+ * the first handler registered, so last. */
+static void cleanup(void) {
+  __wali_cleanup();
+}
+
 __attribute__((export_name("_start")))
 void _start(void) {
-  // Return code for exit
-  int r;
-  r = __wali_startup();
-  if (r) {
-    goto exit_label;
-  }
-  // Call `__main_void` which will either be the application's zero-argument
-  // `__main_void` function or a libc routine which obtains the command-line
-  // arguments and calls `__main_argv_argc`.
-  r = __main_void();
-  if (r) {
-    goto exit_label;
-  }
-  int s = __wali_cleanup();
-  if (s) {
-    // Update the reutrn code with cleanup's error, if it has one
-    r = s;
-  }
-exit_label:
-  __wali_proc_exit(r);
+  int r = __wali_startup();
+  if (r) __wali_proc_exit(r);
+  atexit(cleanup);
+  // `__main_void` is the application's zero-argument main, or a libc routine that gathers the command-line
+  // arguments and calls `__main_argc_argv`
+  exit(__main_void());
 }
